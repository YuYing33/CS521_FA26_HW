import torch
import torch.nn as nn


# fix seed so that random initialization always performs the same
torch.manual_seed(13)


# create the model N as described in the question
N = nn.Sequential(
    nn.Linear(10, 10, bias=False),
    nn.ReLU(),
    nn.Linear(10, 10, bias=False),
    nn.ReLU(),
    nn.Linear(10, 3, bias=False)
)


# random input
x = torch.rand((1, 10))
x.requires_grad_()

# target class for Problem 1.2
t = 1

epsReal = 0.5
eps = epsReal - 1e-7


# The network N classifies x as belonging to class 2
original_class = N(x).argmax(dim=1).item()
print("Original Class: ", original_class)
assert original_class == 2


# First try: same targeted FGSM attack as Problem 1.1
L = nn.CrossEntropyLoss()
loss = L(N(x), torch.tensor([t], dtype=torch.long))
loss.backward()

adv_x = x - eps * x.grad.sign()

fgsm_class = N(adv_x).argmax(dim=1).item()
fgsm_distance = torch.norm(x - adv_x, p=float('inf')).item()

print("FGSM Class: ", fgsm_class)
print("FGSM L_inf distance: ", fgsm_distance)


# If FGSM does not reach class 1, search for a nearby adversarial example
# inside the same L_inf ball.
if fgsm_class != t:
    x_base = x.detach()
    found = False

    for _ in range(100):
        candidates = x_base + (torch.rand(10000, 10) * 2 - 1) * epsReal
        predictions = N(candidates).argmax(dim=1)

        indices = (predictions == t).nonzero(as_tuple=False)

        if len(indices) > 0:
            idx = indices[0].item()
            adv_x = candidates[idx:idx + 1]
            found = True
            break

    if not found:
        raise RuntimeError("No adversarial example was found in the search.")


new_class = N(adv_x).argmax(dim=1).item()
distance = torch.norm(
    x.detach() - adv_x.detach(),
    p=float('inf')
).item()

print("Target Class: ", t)
print("New Class: ", new_class)
print("Final L_inf distance: ", distance)

assert new_class == t
assert distance <= epsReal